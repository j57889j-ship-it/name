[Unit]
Description=Dasturlash and AI Telegram Control Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/dasturlash-ai-control
EnvironmentFile=/opt/dasturlash-ai-control/.env
ExecStart=/opt/dasturlash-ai-control/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/dasturlash-ai-control/logs

[Install]
WantedBy=multi-user.target
